{
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "ia": {
      "root": "IA"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "ia"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}